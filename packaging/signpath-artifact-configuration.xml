<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration d'artefact SignPath (à recopier dans le projet « omnictl » sur
  app.signpath.io, sous le nom « initial »). La CI envoie deux artefacts GitHub : l'un avec
  les exécutables, l'autre avec les paquets MSI ; chacun est un zip dont on signe le contenu.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*.exe" min-matches="0" max-matches="unbounded">
      <authenticode-sign />
    </pe-file>
    <msi-file path="*.msi" min-matches="0" max-matches="unbounded">
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
